# Port the API listens on.
PORT=4173

# Postgres connection string. In production this points at the Postgres
# container on the VPS; for local dev, your local Postgres instance.
DATABASE_URL=postgres://localhost:5432/alreadycovered_dev

# Where uploaded documents and generated exports are stored on disk, scoped
# per user underneath this root. On the VPS this should be a persistent
# Docker volume mount, not an ephemeral container filesystem path.
STORAGE_ROOT=/data/storage

# Comma-separated list of frontend origins allowed to call this API with
# credentials (cookies). Must match exactly (scheme + host + port).
CORS_ORIGIN=http://localhost:5173

# Set to "false" only for same-site local dev (frontend and backend on the
# same host). Leave unset/"true" whenever the frontend and backend are on
# different origins (e.g. Vercel + a VPS) - the session cookie then needs
# SameSite=None; Secure to be sent cross-site at all.
COOKIE_CROSS_SITE=true

# Local Ollama endpoint reachable from the API process. On the VPS this is
# the Ollama container's address on the private Docker network, not loopback
# from the host's perspective.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e2b

LOG_LEVEL=info
